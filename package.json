{
    "name": "gcso-custom-theme",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Build and lint tooling for the GCSO custom WordPress theme",
    "scripts": {
        "lint:js": "eslint gcso-custom/assets/js/",
        "lint:css": "stylelint \"gcso-custom/**/*.css\" \"gcso-custom/style.css\"",
        "security": "npm audit --audit-level=high",
        "ci": "npm run lint:js && npm run lint:css && npm run security"
    },
    "devDependencies": {
        "eslint": "^9.28.0",
        "@eslint/js": "^9.28.0",
        "globals": "^16.1.0",
        "stylelint": "^16.12.0",
        "stylelint-config-standard": "^36.0.0"
    }
}
