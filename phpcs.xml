<?xml version="1.0"?>
<ruleset name="GCSO Custom Theme">
    <description>PHP_CodeSniffer rules for the GCSO Custom WordPress theme.</description>

    <!-- Scan only the theme directory -->
    <file>gcso-custom</file>

    <!-- Exclude non-project directories and generated files -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*\.min\.js$</exclude-pattern>
    <exclude-pattern>*\.min\.css$</exclude-pattern>
    <exclude-pattern>*\.asset\.php$</exclude-pattern>

    <!-- Arguments -->
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/><!-- Show sniff codes and progress -->

    <!-- WordPress Coding Standards (full suite) -->
    <rule ref="WordPress">
        <!-- Allow short array syntax – modern PHP -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- Security-focused rules (these are included via WordPress but listed for clarity) -->
    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
    <rule ref="WordPress.DB.DirectDatabaseQuery"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.Security.SafeRedirect"/>
    <rule ref="WordPress.WP.AlternativeFunctions"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
    <rule ref="WordPress.Security.PluginMenuSlug"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>

    <!-- Minimum supported WordPress version -->
    <config name="minimum_wp_version" value="6.0"/>

    <!-- Text domain for the theme -->
    <config name="text_domain" value="gcso"/>

    <!-- Prefixes used by the theme for functions, classes, and hooks -->
    <config name="prefixes" value="gcso,GCSO"/>

    <!-- Report width -->
    <arg name="report-width" value="120"/>
</ruleset>
